{
  "name": "nodejs-express",
  "version": "1.0.0",
  "services": [
    {
      "name": "nodejs-express",
      "path": ".",
      "port": 3000,
      "hosts": ["nodejs-express.nodejs-express.local.getwebstack.dev"],
      "dockerfile": ".gws/services/nodejs-express/Dockerfile",
      "manifests": ".gws/services/nodejs-express/k8s",
      "fileSync": true,
      "fileSyncIgnore": [
        "node_modules/",
        "dist/",
        "build/",
        "coverage/",
        "/.git",
        "/.idea",
        "/.vscode",
        "/.DS_Store",
        "*.log"
      ]
    }
  ],
  "provision": {
    "environments": {
      "dev": {
        "type": "k3d",
        "default": true
      }
    }
  }
}
